<Window x:Class="ObuvShop.Views.ConnectionSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="sqlr"
        Icon="pack://application:,,,/Resources/Icon.ico"
        FontFamily="Times New Roman"
        Background="#FFFFFF"
        Width="480"
        Height="390"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="ssms"
                       FontSize="17"
                       FontWeight="Bold"
                       Margin="0,0,0,14" />

            <TextBlock Text="server" Margin="0,0,0,4" />
            <TextBox x:Name="ServerTextBox" Height="32" Margin="0,0,0,10" />

            <TextBlock Text="name" Margin="0,0,0,4" />
            <TextBox x:Name="DatabaseTextBox" Height="32" Margin="0,0,0,10" />

            <CheckBox x:Name="TrustedConnectionCheckBox"
                      Content="windows-auth"
                      IsChecked="True"
                      Checked="AuthMode_Changed"
                      Unchecked="AuthMode_Changed"
                      Margin="0,4,0,10" />

            <Grid x:Name="SqlAuthPanel" IsEnabled="False">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="login" Margin="0,0,0,4" />
                    <TextBox x:Name="SqlUserTextBox" Height="30" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="pass" Margin="0,0,0,4" />
                    <PasswordBox x:Name="SqlPasswordBox" Height="30" />
                </StackPanel>
            </Grid>

            <TextBlock x:Name="StatusTextBlock"
                       Margin="0,12,0,0"
                       TextWrapping="Wrap"
                       FontSize="13" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="proverka" Margin="0,0,8,0" Click="TestButton_Click" />
            <Button Content="save" Style="{StaticResource AccentButtonStyle}" Margin="0,0,8,0" Click="SaveButton_Click" />
            <Button Content="" Click="CancelButton_Click" />
        </StackPanel>
    </Grid>
</Window>
