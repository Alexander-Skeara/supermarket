<Window x:Class="ObuvShop.Views.OrderEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ООО «Обувь» — Карточка заказа"
        Icon="pack://application:,,,/Resources/Icon.ico"
        FontFamily="Times New Roman"
        Background="#FFFFFF"
        Width="760"
        Height="640"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeaderTitleText"
                   Grid.Row="0"
                   Text="Новый заказ"
                   FontSize="20"
                   FontWeight="Bold"
                   Margin="0,0,0,12" />

        <!-- Основные реквизиты закаа -->
        <StackPanel Grid.Row="1">
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="150" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Статус заказа *:" FontWeight="Bold" Margin="0,0,0,3" />
                    <ComboBox x:Name="StatusComboBox" Height="30" DisplayMemberPath="Name" SelectedValuePath="Id" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Клиент *:" FontWeight="Bold" Margin="0,0,0,3" />
                    <ComboBox x:Name="ClientComboBox" Height="30" DisplayMemberPath="FullName" SelectedValuePath="UserId" />
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock Text="Код получения *:" FontWeight="Bold" Margin="0,0,0,3" />
                    <TextBox x:Name="PickupCodeTextBox" Height="30" />
                </StackPanel>
            </Grid>

            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Дата заказа *:" FontWeight="Bold" Margin="0,0,0,3" />
                    <DatePicker x:Name="OrderDatePicker" Height="30" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Дата доставки *:" FontWeight="Bold" Margin="0,0,0,3" />
                    <DatePicker x:Name="DeliveryDatePicker" Height="30" />
                </StackPanel>
            </Grid>

            <TextBlock Text="Адрес пункта выдачи *:" FontWeight="Bold" Margin="0,0,0,3" />
            <ComboBox x:Name="PickupPointComboBox" Height="30" DisplayMemberPath="Name" SelectedValuePath="Id" Margin="0,0,0,12" />
        </StackPanel>

        <!-- состав -->
        <Border Grid.Row="2" BorderBrush="#CCCCCC" BorderThickness="1" Padding="10" Background="#FAFAFA">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Состав заказа (товары):" FontWeight="Bold" FontSize="15" Margin="0,0,0,8" />

                <Grid Grid.Row="1" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="75" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ComboBox x:Name="AddProductComboBox" Grid.Column="0" Height="30" DisplayMemberPath="SelectorDisplay" />
                    <TextBox x:Name="AddQtyTextBox" Grid.Column="2" Height="30" Text="1" ToolTip="Количество" />
                    <Button Grid.Column="4" Content="+ Добавить" Style="{StaticResource AccentButtonStyle}" Height="30" Padding="10,2" Click="AddItemButton_Click" />
                    <Button Grid.Column="6" Content="Удалить позицию" Style="{StaticResource DangerButtonStyle}" Height="30" Padding="10,2" Click="RemoveItemButton_Click" />
                </Grid>

                <DataGrid x:Name="OrderItemsGrid"
                          Grid.Row="2"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Артикул" Binding="{Binding ProductArticle}" Width="120" />
                        <DataGridTextColumn Header="Наименование товара" Binding="{Binding ProductName}" Width="*" />
                        <DataGridTextColumn Header="Количество (шт.)" Binding="{Binding Quantity}" Width="140" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Кнопки соохр -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Сохранить" Style="{StaticResource AccentButtonStyle}" Width="130" Margin="0,0,10,0" Click="SaveButton_Click" />
            <Button Content="Отмена" Width="110" Click="CancelButton_Click" />
        </StackPanel>
    </Grid>
</Window>
