<Window x:Class="ObuvShop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ООО «Обувь» — Каталог товаров"
        Icon="pack://application:,,,/Resources/Icon.ico"
        FontFamily="Times New Roman"
        Background="#FFFFFF"
        Width="1120"
        Height="740"
        MinWidth="920"
        MinHeight="600"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Шапка) -->
        <Border Grid.Row="0" Background="{StaticResource SecondaryBackgroundBrush}" Padding="16,10" BorderBrush="#55AA00" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Логотип и название -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/Resources/Icon.png"
                           Height="48"
                           Stretch="Uniform"
                           Margin="0,0,12,0" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="ООО «Обувь»" FontSize="22" FontWeight="Bold" Foreground="#000000" />
                        <TextBlock x:Name="SectionSubtitleText" Text="Каталог товаров" FontSize="13" Foreground="#111111" />
                    </StackPanel>
                </StackPanel>

                <!-- Навигация (Товары / Заказы) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button x:Name="ProductsNavButton"
                            Content="Товары"
                            Width="130"
                            Margin="0,0,10,0"
                            Click="ProductsNavButton_Click" />
                    <Button x:Name="OrdersNavButton"
                            Content="Заказы"
                            Width="130"
                            Visibility="Collapsed"
                            Click="OrdersNavButton_Click" />
                </StackPanel>

                <!-- Текущий пользователь и выход -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
                        <TextBlock x:Name="UserFullNameText"
                                   FontWeight="Bold"
                                   FontSize="14"
                                   HorizontalAlignment="Right"
                                   Foreground="#000000" />
                        <TextBlock x:Name="UserRoleText"
                                   FontSize="12"
                                   HorizontalAlignment="Right"
                                   Foreground="#222222" />
                    </StackPanel>
                    <Button Content="Выход"
                            Padding="14,6"
                            Click="LogoutButton_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Секция ТОВАРЫ -->
        <Grid x:Name="ProductsSection" Grid.Row="1" Margin="16,12,16,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Панель поиска, фильтрации и сортировкитолько менеджер и администрато -->
            <Border x:Name="FilterPanel"
                    Grid.Row="0"
                    Background="#F8F8F8"
                    BorderBrush="#CCCCCC"
                    BorderThickness="1"
                    Padding="12,10"
                    Margin="0,0,0,10"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="1.3*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="1.5*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Поиск (название, артикул, описание, бренд):" FontSize="12" Margin="0,0,0,3" />
                        <TextBox x:Name="SearchTextBox" Height="32" TextChanged="FilterControls_Changed" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Фильтр по поставщику:" FontSize="12" Margin="0,0,0,3" />
                        <ComboBox x:Name="SupplierFilterComboBox" Height="32" SelectionChanged="FilterControls_Changed" />
                    </StackPanel>

                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Сортировка:" FontSize="12" Margin="0,0,0,3" />
                        <ComboBox x:Name="SortComboBox" Height="32" SelectionChanged="FilterControls_Changed">
                            <ComboBoxItem Content="По умолчанию" IsSelected="True" />
                            <ComboBoxItem Content="Кол-во на складе (по возрастанию)" />
                            <ComboBoxItem Content="Кол-во на складе (по убыванию)" />
                            <ComboBoxItem Content="Цена (по возрастанию)" />
                            <ComboBoxItem Content="Цена (по убыванию)" />
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Column="6" VerticalAlignment="Bottom">
                        <Button Content="Сбросить" Height="32" Padding="12,4" Click="ResetFiltersButton_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Панель действий адмтина + счётчик -->
            <DockPanel Grid.Row="1" Margin="0,0,0,10" LastChildFill="False">
                <StackPanel x:Name="ProductsAdminPanel"
                            DockPanel.Dock="Left"
                            Orientation="Horizontal"
                            Visibility="Collapsed">
                    <Button Content="+ Добавить товар"
                            Style="{StaticResource AccentButtonStyle}"
                            Margin="0,0,8,0"
                            Click="AddProductButton_Click" />
                    <Button Content="Редактировать"
                            Margin="0,0,8,0"
                            Click="EditProductButton_Click" />
                    <Button Content="Удалить"
                            Style="{StaticResource DangerButtonStyle}"
                            Click="DeleteProductButton_Click" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#2E8B57" Width="14" Height="14" Margin="0,0,5,0" BorderBrush="#666666" BorderThickness="1" />
                    <TextBlock Text="Скидка &gt; 15%   " FontSize="12" VerticalAlignment="Center" />
                    <Border Background="#ADD8E6" Width="14" Height="14" Margin="0,0,5,0" BorderBrush="#666666" BorderThickness="1" />
                    <TextBlock Text="Нет на складе   |   " FontSize="12" VerticalAlignment="Center" />
                    <TextBlock x:Name="ProductsCountText"
                               FontWeight="Bold"
                               FontSize="14"
                               VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>

            <!-- Список товаров -->
            <ListBox x:Name="ProductsListBox"
                     Grid.Row="2"
                     Background="#FFFFFF"
                     BorderBrush="#CCCCCC"
                     BorderThickness="1"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     HorizontalContentAlignment="Stretch"
                     MouseDoubleClick="ProductsListBox_MouseDoubleClick">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="4" />
                        <Setter Property="Margin" Value="4,3" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{Binding Converter={StaticResource ProductCardBackgroundConverter}}"
                                BorderBrush="#444444"
                                BorderThickness="1"
                                Padding="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="135" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="125" />
                                </Grid.ColumnDefinitions>

                                <!-- Фото товара или загл -->
                                <Border Grid.Column="0"
                                        Background="#FFFFFF"
                                        BorderBrush="#999999"
                                        BorderThickness="1"
                                        Width="120"
                                        Height="120"
                                        Padding="4"
                                        VerticalAlignment="Center">
                                    <Image Source="{Binding PhotoPath, Converter={StaticResource ProductPhotoConverter}}"
                                           Stretch="Uniform" />
                                </Border>

                                <!-- Информация о товаре -->
                                <StackPanel Grid.Column="1" Margin="14,0,14,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TitleDisplay}"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               Foreground="{Binding Converter={StaticResource ProductCardForegroundConverter}}"
                                               Margin="0,0,0,2" />

                                    <TextBlock Foreground="{Binding Converter={StaticResource ProductCardForegroundConverter}}"
                                               FontSize="13"
                                               Margin="0,0,0,2">
                                        <Run Text="Артикул: " FontWeight="Bold" />
                                        <Run Text="{Binding Article}" />
                                    </TextBlock>

                                    <TextBlock TextWrapping="Wrap"
                                               Foreground="{Binding Converter={StaticResource ProductCardForegroundConverter}}"
                                               Margin="0,0,0,2">
                                        <Run Text="Описание товара: " FontWeight="Bold" />
                                        <Run Text="{Binding Description}" />
                                    </TextBlock>

                                    <TextBlock Foreground="{Binding Converter={StaticResource ProductCardForegroundConverter}}" Margin="0,0,0,2">
                                        <Run Text="Производитель: " FontWeight="Bold" />
                                        <Run Text="{Binding ManufacturerName}" />
                                        <Run Text="   |   Поставщик: " FontWeight="Bold" />
                                        <Run Text="{Binding SupplierName}" />
                                    </TextBlock>

                                    <!-- Цена (со скидкой и без скидки) -->
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
                                        <TextBlock Text="Цена: "
                                                   FontWeight="Bold"
                                                   Foreground="{Binding Converter={StaticResource ProductCardForegroundConverter}}" />
                                        <TextBlock Text="{Binding Price, StringFormat={}{0:N2} ₽}"
                                                   TextDecorations="Strikethrough"
                                                   Foreground="{Binding Converter={StaticResource ProductOldPriceForegroundConverter}}"
                                                   Margin="0,0,8,0"
                                                   Visibility="{Binding HasDiscount, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <TextBlock Text="{Binding FinalPrice, StringFormat={}{0:N2} ₽}"
                                                   FontWeight="Bold"
                                                   Foreground="{Binding Converter={StaticResource ProductCardForegroundConverter}}" />
                                    </StackPanel>

                                    <TextBlock Foreground="{Binding Converter={StaticResource ProductCardForegroundConverter}}">
                                        <Run Text="Единица измерения: " FontWeight="Bold" />
                                        <Run Text="{Binding UnitName}" />
                                        <Run Text="   |   Количество на складе: " FontWeight="Bold" />
                                        <Run Text="{Binding StockDisplay, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>

                                <!-- Блок действующей скидки -->
                                <Border Grid.Column="2"
                                        BorderBrush="#444444"
                                        BorderThickness="1,0,0,0"
                                        Padding="10,6"
                                        VerticalAlignment="Stretch">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="Действующая скидка"
                                                   FontSize="12"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   Foreground="{Binding Converter={StaticResource ProductCardForegroundConverter}}" />
                                        <TextBlock Text="{Binding Discount, StringFormat={}{0}%}"
                                                   FontSize="24"
                                                   FontWeight="Bold"
                                                   TextAlignment="Center"
                                                   Margin="0,4,0,0"
                                                   Foreground="{Binding Converter={StaticResource ProductCardForegroundConverter}}" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <!-- Секция ЗАКАЗЫ (Менеджер — просмотр, Администратор — CRUD) -->
        <Grid x:Name="OrdersSection" Grid.Row="1" Margin="16,12,16,12" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,10" LastChildFill="False">
                <StackPanel x:Name="OrdersAdminPanel"
                            DockPanel.Dock="Left"
                            Orientation="Horizontal"
                            Visibility="Collapsed">
                    <Button Content="+ Добавить заказ"
                            Style="{StaticResource AccentButtonStyle}"
                            Margin="0,0,8,0"
                            Click="AddOrderButton_Click" />
                    <Button Content="Редактировать"
                            Margin="0,0,8,0"
                            Click="EditOrderButton_Click" />
                    <Button Content="Удалить"
                            Style="{StaticResource DangerButtonStyle}"
                            Click="DeleteOrderButton_Click" />
                </StackPanel>

                <TextBlock x:Name="OrdersCountText"
                           DockPanel.Dock="Right"
                           FontWeight="Bold"
                           FontSize="14"
                           VerticalAlignment="Center" />
            </DockPanel>

            <ListBox x:Name="OrdersListBox"
                     Grid.Row="1"
                     Background="#FFFFFF"
                     BorderBrush="#CCCCCC"
                     BorderThickness="1"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     HorizontalContentAlignment="Stretch"
                     MouseDoubleClick="OrdersListBox_MouseDoubleClick">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="4" />
                        <Setter Property="Margin" Value="4,3" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#FFFFFF" BorderBrush="#444444" BorderThickness="1" Padding="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="170" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="{Binding OrderId, StringFormat=Заказ № {0}}"
                                                   FontSize="16"
                                                   FontWeight="Bold"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,12,0" />
                                        <Border Background="{Binding StatusName, Converter={StaticResource OrderStatusBrushConverter}}"
                                                BorderBrush="#444444"
                                                BorderThickness="1"
                                                Padding="8,2">
                                            <TextBlock Text="{Binding StatusName}" FontWeight="Bold" FontSize="13" />
                                        </Border>
                                    </StackPanel>

                                    <TextBlock TextWrapping="Wrap" Margin="0,2,0,2">
                                        <Run Text="Артикулы заказа: " FontWeight="Bold" />
                                        <Run Text="{Binding ArticlesSummary, Mode=OneWay}" />
                                    </TextBlock>

                                    <TextBlock Margin="0,2,0,2">
                                        <Run Text="Клиент: " FontWeight="Bold" />
                                        <Run Text="{Binding ClientFullName}" />
                                        <Run Text="   |   Код для получения: " FontWeight="Bold" />
                                        <Run Text="{Binding PickupCode}" />
                                    </TextBlock>

                                    <TextBlock TextWrapping="Wrap" Margin="0,2,0,2">
                                        <Run Text="Адрес пункта выдачи: " FontWeight="Bold" />
                                        <Run Text="{Binding PickupPointAddress}" />
                                    </TextBlock>

                                    <TextBlock Margin="0,2,0,0">
                                        <Run Text="Дата заказа: " FontWeight="Bold" />
                                        <Run Text="{Binding OrderDate, StringFormat={}{0:dd.MM.yyyy}}" />
                                    </TextBlock>
                                </StackPanel>

                                <Border Grid.Column="1"
                                        BorderBrush="#444444"
                                        BorderThickness="1,0,0,0"
                                        Padding="12,6"
                                        VerticalAlignment="Stretch">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="Дата доставки" FontSize="13" TextAlignment="Center" />
                                        <TextBlock Text="{Binding DeliveryDate, StringFormat={}{0:dd.MM.yyyy}}"
                                                   FontSize="18"
                                                   FontWeight="Bold"
                                                   TextAlignment="Center"
                                                   Margin="0,6,0,0" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Grid>
</Window>
