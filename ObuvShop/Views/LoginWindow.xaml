<Window x:Class="ObuvShop.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ООО «Обувь» — Авторизация"
        Icon="pack://application:,,,/Resources/Icon.ico"
        FontFamily="Times New Roman"
        Background="#FFFFFF"
        Width="480"
        Height="520"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource SecondaryBackgroundBrush}" Padding="16,14" BorderBrush="#55AA00" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Image Source="pack://application:,,,/Resources/Icon.png"
                       Height="54"
                       Stretch="Uniform"
                       Margin="0,0,14,0" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="ООО «Обувь»" FontSize="24" FontWeight="Bold" Foreground="#000000" />
                    <TextBlock Text="Информационная система магазина обуви" FontSize="13" Foreground="#111111" />
                </StackPanel>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" Margin="40,24,40,16" VerticalAlignment="Center">
            <TextBlock Text="Вход в систему"
                       FontSize="20"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,18" />

            <TextBlock Text="Логин:" FontWeight="Bold" Margin="0,0,0,4" />
            <TextBox x:Name="LoginTextBox"
                     Height="34"
                     Margin="0,0,0,14"
                     KeyDown="Input_KeyDown" />

            <TextBlock Text="Пароль:" FontWeight="Bold" Margin="0,0,0,4" />
            <PasswordBox x:Name="PasswordBoxInput"
                         Height="34"
                         Margin="0,0,0,8"
                         KeyDown="Input_KeyDown" />

            <TextBlock x:Name="ErrorTextBlock"
                       Foreground="#CC0000"
                       TextWrapping="Wrap"
                       FontSize="13"
                       Margin="0,4,0,12"
                       Visibility="Collapsed" />

            <Button x:Name="LoginButton"
                    Content="Войти"
                    Style="{StaticResource AccentButtonStyle}"
                    Height="38"
                    Margin="0,8,0,10"
                    Click="LoginButton_Click" />

            <Button x:Name="GuestButton"
                    Content="Войти как гость (просмотр товаров)"
                    Height="36"
                    Click="GuestButton_Click" />
        </StackPanel>

        <Border Grid.Row="2" Background="#F7F7F7" BorderBrush="#DDDDDD" BorderThickness="0,1,0,0" Padding="14,8">
            <DockPanel LastChildFill="False">
                <TextBlock DockPanel.Dock="Left"
                           Text="БД: ObuvDB"
                           FontSize="12"
                           Foreground="#555555"
                           VerticalAlignment="Center" />
                <Button Content="настройка бд"
                        DockPanel.Dock="Right"
                        FontSize="12"
                        Padding="10,4"
                        Click="DbSettingsButton_Click" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
