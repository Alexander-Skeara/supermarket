<Window x:Class="ObuvShop.Views.ProductEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ООО «Обувь» — Карточка товара"
        Icon="pack://application:,,,/Resources/Icon.ico"
        FontFamily="Times New Roman"
        Background="#FFFFFF"
        Width="740"
        Height="610"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeaderTitleText"
                   Grid.Row="0"
                   Text="Добавление товара"
                   FontSize="20"
                   FontWeight="Bold"
                   Margin="0,0,0,14" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Блок фотографии -->
            <StackPanel Grid.Column="0">
                <Border BorderBrush="#888888" BorderThickness="1" Width="200" Height="200" Padding="6" Background="#FFFFFF">
                    <Image x:Name="PreviewImage" Stretch="Uniform" />
                </Border>
                <TextBlock x:Name="PhotoFileNameText"
                           Text="Фото не выбрано"
                           FontSize="12"
                           Foreground="#555555"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,6,0,8" />
                <Button Content="Выбрать фото..." Margin="0,0,0,6" Click="SelectPhotoButton_Click" />
                <Button Content="Убрать фото" Click="ClearPhotoButton_Click" />
            </StackPanel>

            <!-- Поля товара -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,6,0">
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Артикул *:" FontWeight="Bold" Margin="0,0,0,3" />
                            <TextBox x:Name="ArticleTextBox" Height="30" MaxLength="20" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Наименование *:" FontWeight="Bold" Margin="0,0,0,3" />
                            <TextBox x:Name="NameTextBox" Height="30" MaxLength="150" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Категория *:" FontWeight="Bold" Margin="0,0,0,3" />
                            <ComboBox x:Name="CategoryComboBox" Height="30" DisplayMemberPath="Name" SelectedValuePath="Id" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Единица измерения *:" FontWeight="Bold" Margin="0,0,0,3" />
                            <ComboBox x:Name="UnitComboBox" Height="30" DisplayMemberPath="Name" SelectedValuePath="Id" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Производитель *:" FontWeight="Bold" Margin="0,0,0,3" />
                            <ComboBox x:Name="ManufacturerComboBox" Height="30" DisplayMemberPath="Name" SelectedValuePath="Id" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Поставщик *:" FontWeight="Bold" Margin="0,0,0,3" />
                            <ComboBox x:Name="SupplierComboBox" Height="30" DisplayMemberPath="Name" SelectedValuePath="Id" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Цена (₽) *:" FontWeight="Bold" Margin="0,0,0,3" />
                            <TextBox x:Name="PriceTextBox" Height="30" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Скидка (0–100%):" FontWeight="Bold" Margin="0,0,0,3" />
                            <TextBox x:Name="DiscountTextBox" Height="30" Text="0" />
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="На складе *:" FontWeight="Bold" Margin="0,0,0,3" />
                            <TextBox x:Name="StockTextBox" Height="30" Text="0" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Описание товара:" FontWeight="Bold" Margin="0,2,0,3" />
                    <TextBox x:Name="DescriptionTextBox"
                             Height="110"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalContentAlignment="Top"
                             VerticalScrollBarVisibility="Auto" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Сохранить" Style="{StaticResource AccentButtonStyle}" Width="130" Margin="0,0,10,0" Click="SaveButton_Click" />
            <Button Content="Отмена" Width="110" Click="CancelButton_Click" />
        </StackPanel>
    </Grid>
</Window>
